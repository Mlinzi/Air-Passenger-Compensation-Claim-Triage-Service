# Copy to .env and fill in. Nothing here is committed with real values (D4).
# ---- secrets --------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# ---- model provider (behind the llm-gateway; switch by configuration only) -------
# stub          : fixed responses after STUB_DELAY_S seconds (default; used for load tests)
# Local Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1, LLM_API_KEY=ollama, LLM_TIMEOUT_S=90,
#   AGENT_WALL_CLOCK_S=300, GATEWAY_CALL_TIMEOUT_S=120, VERIFIER_TIMEOUT_S=200 (an 8B model such as llama3.1 tested OK)
# openai_compat : any OpenAI-compatible /chat/completions endpoint (Groq, Gemini OpenAI
#                 endpoint, OpenRouter, a local Ollama, ...). Set the three values below.
LLM_PROVIDER=stub
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# USD per 1k tokens at the time of the call (0 on a free tier; set list prices to model cost)
LLM_PRICE_PROMPT_PER_1K=0.00059
LLM_PRICE_COMPLETION_PER_1K=0.00079
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3
BREAKER_FAIL_THRESHOLD=5
BREAKER_RESET_S=30
STUB_DELAY_S=1.5

# ---- retrieval ---------------------------------------------------------------------
# Local sentence-transformers model (downloaded once into the `models` volume). A small
# model such as all-MiniLM-L6-v2 from the sentence-transformers hub keeps memory low.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_K=5

# ---- agent loop bounds (A1) ---------------------------------------------------------
AGENT_MAX_STEPS=60
AGENT_MAX_TOOL_CALLS=45
AGENT_WALL_CLOCK_S=90
AGENT_MAX_VERIFY_RETRIES=2
PROMPT_VERSION=v3

# ---- cost controls (D7) ------------------------------------------------------------
CACHE_ENABLED=true
RATE_LIMIT_PER_MIN=30

# ---- demo hooks (fault injection; never enable in production) ----------------------
DEMO_MODE=true
LOG_LEVEL=INFO

# ---- load test ---------------------------------------------------------------------
LOCUST_USERS=10
LOCUST_SPAWN_RATE=2
LOCUST_DURATION=3m
