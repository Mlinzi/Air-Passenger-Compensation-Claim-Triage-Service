{
 "uid": "triage",
 "title": "Claim Triage Service",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Run end-to-end latency (submission \u2192 result) p50 / p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(run_end_to_end_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(run_end_to_end_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "API latency p50 / p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(http_request_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(http_request_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Throughput (runs/s, requests/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(runs_total[1m]))",
     "legendFormat": "runs/s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_requests_total{route=\"/claims\"}[1m]))",
     "legendFormat": "submissions/s"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Error rate (5xx / all)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total[1m])),1e-9)",
     "legendFormat": "5xx ratio"
    },
    {
     "refId": "B",
     "expr": "sum(rate(runs_total{status=\"escalated\"}[5m])) / clamp_min(sum(rate(runs_total[5m])),1e-9)",
     "legendFormat": "escalation ratio"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Availability (up) per service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg by (job) (up)",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(run_queue_depth)",
     "legendFormat": "queued runs"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Agent task success rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(agent_tasks_total{outcome=~\"success|pass\"}[5m])) / clamp_min(sum by (agent) (rate(agent_tasks_total[5m])),1e-9)",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Steps per run (avg) by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(agent_steps_per_run_sum[5m])) / clamp_min(sum by (agent) (rate(agent_steps_per_run_count[5m])),1e-9)",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tool calls per run (avg) by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(agent_tool_calls_per_run_sum[5m])) / clamp_min(sum by (agent) (rate(agent_tool_calls_per_run_count[5m])),1e-9)",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Per-step latency p95 by agent/step",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(agent_step_seconds_bucket[1m])) by (le, agent, step))",
     "legendFormat": "{{agent}}.{{step}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Retry rate by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, kind) (rate(agent_retries_total[5m]))",
     "legendFormat": "{{agent}} {{kind}}"
    },
    {
     "refId": "B",
     "expr": "sum(rate(llm_retries_total[5m]))",
     "legendFormat": "provider retries"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Container (process) uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (service, instance) (container_uptime_seconds)",
     "legendFormat": "{{service}} {{instance}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "CPU per container",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Memory per container",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "LLM cost (USD/min) by agent step",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, step) (rate(llm_cost_usd_total[5m]))*60",
     "legendFormat": "{{agent}}.{{step}}"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "LLM tokens/s by type",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(llm_tokens_total[5m]))",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(llm_circuit_state)",
     "legendFormat": "state"
    }
   ]
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Cache hit ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cache) (rate(cache_events_total{event=\"hit\"}[5m])) / clamp_min(sum by (cache) (rate(cache_events_total[5m])),1e-9)",
     "legendFormat": "{{cache}}"
    }
   ]
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Guardrails / quarantine / rate-limit",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (increase(guardrail_events_total[5m]))",
     "legendFormat": "guard {{kind}}"
    },
    {
     "refId": "B",
     "expr": "sum(increase(quarantined_total[5m]))",
     "legendFormat": "quarantined"
    },
    {
     "refId": "C",
     "expr": "sum(increase(rate_limited_total[5m]))",
     "legendFormat": "rate limited"
    }
   ]
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Index freshness",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(index_age_seconds)",
     "legendFormat": "index age (s)"
    },
    {
     "refId": "B",
     "expr": "max(index_chunks)",
     "legendFormat": "chunks"
    },
    {
     "refId": "C",
     "expr": "max(index_pipeline_chunks_per_second)",
     "legendFormat": "pipeline chunks/s"
    }
   ]
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "Live quality over time (sampled runs, 15 min window) \u2014 L6",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (metric) (increase(live_quality_score_sum[15m])) / clamp_min(sum by (metric) (increase(live_quality_score_count[15m])), 1e-9)",
     "legendFormat": "{{metric}}"
    }
   ]
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Caller feedback (satisfactory share, 1 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 49,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(feedback_total{satisfactory=\"true\"}[1h])) / clamp_min(sum(increase(feedback_total[1h])), 1e-9)",
     "legendFormat": "satisfactory"
    },
    {
     "refId": "B",
     "expr": "sum by (satisfactory) (increase(feedback_total[1h]))",
     "legendFormat": "count {{satisfactory}}"
    }
   ]
  },
  {
   "id": 23,
   "type": "timeseries",
   "title": "CPU per service container (process metrics)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 49,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job, instance) (rate(process_cpu_seconds_total[1m]))",
     "legendFormat": "{{job}} {{instance}}"
    }
   ]
  },
  {
   "id": 24,
   "type": "timeseries",
   "title": "Memory (RSS) per service container (process metrics)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 57,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job, instance) (process_resident_memory_bytes)",
     "legendFormat": "{{job}} {{instance}}"
    }
   ]
  },
  {
   "id": 25,
   "type": "timeseries",
   "title": "Open file descriptors per service container",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 57,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job, instance) (process_open_fds)",
     "legendFormat": "{{job}} {{instance}}"
    }
   ]
  }
 ],
 "tags": [
  "triage"
 ]
}